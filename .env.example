APP_NAME=Read-Assist
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# ─────────────────────────────────────────────────────────────
# DATABASE
# Local default SQLite. Untuk production gunakan MySQL/Postgres:
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1 / DB_PORT=3306 / DB_DATABASE=read_assist
#   DB_USERNAME=read_assist / DB_PASSWORD=<password kuat>
# JANGAN pakai password kosong di production.
# ─────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ─────────────────────────────────────────────────────────────
# SESSION & CACHE
# SESSION_DRIVER=database memerlukan tabel `sessions` (migration
# termasuk di migrate:fresh). Untuk produksi skala besar bisa pakai
# redis/memcached. Aktifkan SESSION_SECURE_COOKIE saat HTTPS aktif.
# ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────
# MAIL
# Local default `log` (email tampil di storage/logs). Production
# WAJIB SMTP sungguhan agar email reset password terkirim:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.example.com / MAIL_PORT=587
#   MAIL_USERNAME= / MAIL_PASSWORD=
#   MAIL_ENCRYPTION=tls
# ─────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_ENCRYPTION=tls

# ─────────────────────────────────────────────────────────────
# OBJECT STORAGE (opsional, saat data sudah besar)
# Audio & file buku bisa dipindah ke S3/object storage dengan
# set FILESYSTEM_DISK=s3 + kredensial AWS di bawah.
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────
# TTS (Text-to-Speech)
# ─────────────────────────────────────────────────────────────
TTS_PROVIDER=google
# GOOGLE_TTS_URL=https://translate.google.com/translate_tts
# TTS_TIMEOUT=120

# ─────────────────────────────────────────────────────────────
# NineRouter (OpenRouter-compatible) — dipakai untuk fitur AI.
# NINEROUTER_KEY asli JANGAN di-commit ke git; isi manual di server.
# ─────────────────────────────────────────────────────────────
NINEROUTER_BASE_URL=http://localhost:20128
NINEROUTER_API_URL=http://localhost:20128/v1
NINEROUTER_KEY=
NINEROUTER_DASHBOARD_URL=http://localhost:20128/dashboard/combos
